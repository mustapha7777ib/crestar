# Postgres connection string (Neon, Supabase, Vercel Postgres or local).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crestar"

# Public origin of the site. Used for payment return/webhook URLs, emails and the sitemap.
APP_URL="http://localhost:3000"

# --- Payments: SkipCash (https://dev.skipcash.app) ---
# From the SkipCash merchant portal (merchantportal.skipcash.app) → Online payments →
# Sandbox or Production → Credentials. Leave them empty in development to use the
# built-in demo gateway instead.
SKIPCASH_CLIENT_ID=""
SKIPCASH_KEY_ID=""
SKIPCASH_KEY_SECRET=""
# Webhook key from the same Credentials page. Used to check that webhooks really
# come from SkipCash.
SKIPCASH_WEBHOOK_KEY=""
# "sandbox" sends payments to https://skipcashtest.azurewebsites.net (test cards only).
# Anything else uses the live API at https://api.skipcash.app.
SKIPCASH_ENV="sandbox"
# Set to "demo" to force the simulated gateway (e.g. on a preview deploy).
# Never set this on the live store: the demo gateway accepts orders without taking money.
PAYMENT_PROVIDER=""

# --- Admin (/admin) ---
# Basic-auth login for the orders page. Admin is disabled until a password is set.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# --- Email (Resend, https://resend.com) ---
# Without RESEND_API_KEY, customer emails are only written to the server log.
RESEND_API_KEY=""
# Must use a domain verified in Resend.
EMAIL_FROM="Crestar Trading <orders@crestartrading.com>"
EMAIL_REPLY_TO="hello@crestartrading.com"

# --- Photo uploads (Vercel Blob) ---
# Set automatically when a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN=""
